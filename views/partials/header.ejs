<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> · Anime Notes</title>
    <script>
        (function () {
            try {
                var stored = localStorage.getItem("theme");
                var theme = stored || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
                document.documentElement.setAttribute("data-bs-theme", theme);
            } catch (e) {}
        })();
    </script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/main.css" rel="stylesheet">
</head>
<body>
    <nav class="navbar navbar-expand-md navbar-dark app-navbar">
        <div class="container">
            <a class="navbar-brand" href="/">Anime Notes</a>
            <button type="button" id="themeToggle" class="btn theme-toggle-btn ms-auto me-2" aria-label="Toggle dark mode" title="Toggle dark mode">
                <span id="themeToggleIcon">🌙</span>
            </button>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/anime">Browse</a></li>
                    <li class="nav-item"><a class="nav-link" href="/anime/add">Add Anime</a></li>
                </ul>
            </div>
        </div>
    </nav>
    <main class="container py-4 page-transition">
