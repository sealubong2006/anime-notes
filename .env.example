# Local development: connect via discrete Postgres variables.
PORT=3000
DB_USER=your_db_user
DB_HOST=localhost
DB_NAME=your_db_name
DB_PASSWORD=your_db_password
DB_PORT=5432

# Production (e.g. Render): set DATABASE_URL instead of the DB_* variables
# above. When present, DATABASE_URL takes priority and the connection uses
# SSL, matching what a hosted Postgres instance requires.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Long random string used to sign the session cookie. Generate your own,
# e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string

# bcrypt hash of your admin password — never the plaintext password itself.
# Generate it locally, e.g.: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=replace_with_a_bcrypt_hash

# Set to "production" when deployed (enables secure cookies + trust proxy).
NODE_ENV=development
